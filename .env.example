NODE_ENV=development
PORT=3000

# Backend runtime
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=onehealth
# Base logique séparée pour les données institutionnelles du Hub. Si l'URI
# n'est pas fournie, le backend réutilise le même cluster MongoDB.
HUB_MONGODB_URI=
HUB_MONGODB_DB_NAME=onehealth_hub
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=1h
# Client ID OAuth "Web application" cree dans Google Cloud Console
# (APIs & Services > Identifiants). Meme valeur cote frontend
# (environment.googleClientId). Laisser vide desactive /auth/google (501).
GOOGLE_CLIENT_ID='426659586297-d70l5m48rqt03hl3ugm9lc5skoofo9c9.apps.googleusercontent.com'
CORS_ORIGIN=http://localhost:4200,http://localhost:8100
PUBLIC_BASE_URL=http://localhost:3000
# En production : /home/yabain/apps/onehealth-data/uploads
UPLOADS_DIR=./uploads
FRONTEND_PUBLIC_URL=http://localhost:8100
SITE_NAME=One Health Network
SITE_DEFAULT_DESCRIPTION=One Health Network réunit les acteurs de la santé humaine, animale, végétale et environnementale : publications, profils professionnels, alertes sanitaires cartographiées, messagerie et Rudolf AI, l’assistant spécialisé One Health.


DEFAULT_SHARE_IMAGE=
TWITTER_SITE_HANDLE=@onehealthnetwork

SWAGGER_ENABLED=false
SWAGGER_PATH=api/docs
SWAGGER_TITLE=One Health Network API
SWAGGER_DESCRIPTION=REST API documentation for One Health Network.
SWAGGER_VERSION=1.0.0
FRONTEND_RESET_PASSWORD_URL=http://localhost:8100/reset-password
RESET_PASSWORD_TOKEN_TTL_MINUTES=30


SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@onehealthnetwork.yaba-in.com

# Rudolf AI — secret uniquement côté backend, jamais dans Angular.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=30000
RUDOLF_RATE_LIMIT_PER_10_MIN=12
RUDOLF_DAILY_LIMIT=100
