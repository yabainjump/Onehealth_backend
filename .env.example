NODE_ENV=development
PORT=3000

# Backend runtime
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=onehealth
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:4200,http://localhost:8100
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:8100
SITE_NAME=One Health Network
SITE_DEFAULT_DESCRIPTION=A global collaboration network for human, animal, and environmental health.
DEFAULT_SHARE_IMAGE=http://localhost:8100/assets/images/logo-onehealth-in-cameroon.png
TWITTER_SITE_HANDLE=@onehealthnetwork
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=One Health Network API
SWAGGER_DESCRIPTION=REST API documentation for One Health Network.
SWAGGER_VERSION=1.0.0
FRONTEND_RESET_PASSWORD_URL=http://localhost:8100/reset-password
RESET_PASSWORD_TOKEN_TTL_MINUTES=30

# Firebase -> Mongo migration scripts
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_AUTH_EXPORT_PATH=./exports/firebase-auth-users.json
MIGRATION_DEFAULT_PASSWORD=ChangeMe-ResetAfterMigration
