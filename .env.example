NODE_ENV=development
PORT=3000

# Backend runtime
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=onehealth
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:4200,http://localhost:8100
FRONTEND_RESET_PASSWORD_URL=http://localhost:8100/reset-password
RESET_PASSWORD_TOKEN_TTL_MINUTES=30

# Firebase -> Mongo migration scripts
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_AUTH_EXPORT_PATH=./exports/firebase-auth-users.json
MIGRATION_DEFAULT_PASSWORD=ChangeMe-ResetAfterMigration
