NODE_ENV=development
PORT=3000

# Backend runtime
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=onehealth
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:4200,http://localhost:8100
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:8100
SITE_NAME=One Health Network
SITE_DEFAULT_DESCRIPTION=One Health Network connecte les experts de la santé humaine, animale et environnementale pour prévenir les zoonoses et coordonner la réponse aux crises sanitaires : profils vérifiés, cartographie des acteurs, appels à projets, messagerie et l'assistant Rudolf AI.
# Image d'apercu de partage (Open Graph). Laisser VIDE = le backend utilise
# automatiquement /assets/images/onehealth-share.png sur le domaine frontend
# (FRONTEND_PUBLIC_URL). Ou mettre une URL absolue complete pour forcer.
DEFAULT_SHARE_IMAGE=
TWITTER_SITE_HANDLE=@onehealthnetwork
# Doc Swagger (/api/docs). Par defaut : ACTIVE en dev, DESACTIVEE en production.
# Pour l'exposer aussi en prod, mettre explicitement SWAGGER_ENABLED=true.
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=One Health Network API
SWAGGER_DESCRIPTION=REST API documentation for One Health Network.
SWAGGER_VERSION=1.0.0
FRONTEND_RESET_PASSWORD_URL=http://localhost:8100/reset-password
RESET_PASSWORD_TOKEN_TTL_MINUTES=30

# Email SMTP (pour l'envoi des liens de reinitialisation de mot de passe)
# Laisser vide pour desactiver l'envoi (le flux ne casse pas, aucun email n'est envoye).
# Compatible avec un SMTP classique (cPanel/yaba-in, Gmail) ou un service transactionnel
# offrant du SMTP (Resend, SendGrid, Mailgun, Brevo...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@onehealthnetwork.yaba-in.com
