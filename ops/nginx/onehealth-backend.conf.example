upstream onehealth_backend {
    # PM2 cluster distributes this shared Node.js port between two workers.
    server 127.0.0.1:3000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name backend.onehealthnetwork.yaba-in.com;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name backend.onehealthnetwork.yaba-in.com;

    ssl_certificate /etc/letsencrypt/live/backend.onehealthnetwork.yaba-in.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/backend.onehealthnetwork.yaba-in.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:onehealth_tls:10m;
    ssl_session_timeout 1d;

    client_max_body_size 50m;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://onehealth_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
        proxy_request_buffering on;

        # The infrastructure never replays an interrupted write automatically.
        proxy_next_upstream off;
    }
}
